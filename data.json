      "answer": "AC",
      "analysis": "【自己做】X~N(1.8,0.01), P(X>2)≈0.0228; Y~N(2.1,0.01), P(Y>2)≈0.8413",
      "useCount": 0,
      "createdAt": "2026-08-17 14:16:26",
      "updatedAt": "2026-08-17 14:23:45"
